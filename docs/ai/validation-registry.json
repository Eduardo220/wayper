  "rules": [
    {
      "id": "minimal",
      "when": {
        "operations": [
          "DOC_ONLY",
          "TRIVIAL"
        ]
      },
      "repositories": [
        "wayper",
        "wayper-site"
      ],
      "checks": [
        "mobile-diff",
        "site-diff"
      ]
    },
    {
      "id": "material-static",
      "when": {
        "operations": [
          "CONFIG",
          "TEST_ONLY",
          "BUG_FIX",
          "FEATURE",
          "REFACTOR",
          "ARCHITECTURAL",
          "CRITICAL_RUNTIME"
        ]
      },
      "repositories": [
        "wayper",
        "wayper-site"
      ],
      "checks": [
        "mobile-static",
        "site-static"
      ]
    },
    {
      "id": "logic",
      "when": {
        "operations": [
          "TEST_ONLY",
          "BUG_FIX",
          "FEATURE",
          "REFACTOR",
          "ARCHITECTURAL",
          "CRITICAL_RUNTIME"
        ]
      },
      "repositories": [
        "wayper",
        "wayper-site"
      ],
      "checks": [
        "mobile-L1",
        "site-L1"
      ]
    },
    {
      "id": "architecture",
      "when": {
        "operations": [
          "ARCHITECTURAL",
          "CRITICAL_RUNTIME"
        ]
      },
      "repositories": [
        "wayper",
        "wayper-site"
      ],
      "checks": [
        "mobile-L2",
        "site-L2"
      ]
    },
    {
      "id": "durability",
      "when": {
        "domains": [
          "PERSISTENCE_SYNC",
          "RUN_RUNTIME",
          "FIREBASE_AUTH",
          "TERRITORY_GEO"
        ],
        "operations": [
          "CONFIG",
          "TEST_ONLY",
          "BUG_FIX",
          "FEATURE",
          "REFACTOR",
          "ARCHITECTURAL",
          "CRITICAL_RUNTIME"
        ]
      },
      "repositories": [
        "wayper",
        "wayper-site"
      ],
      "checks": [
        "mobile-L2",
        "site-L2"
      ]
    },
    {
      "id": "local-first-contract",
      "when": {
        "capabilities": [
          "durable-run-save",
          "run-finalization",
          "active-run-recovery"
        ],
        "operations": [
          "CONFIG",
          "TEST_ONLY",
          "BUG_FIX",
          "FEATURE",
          "REFACTOR",
          "ARCHITECTURAL",
          "CRITICAL_RUNTIME"
        ]
      },
      "repositories": [
        "wayper"
      ],
      "checks": [
        "mobile-local-first"
      ]
    },
    {
      "id": "material-risks",
      "when": {
        "risks": [
          "RUN_DATA_LOSS",
          "CONCURRENCY",
          "OFFLINE_STORAGE",
          "SYNC",
          "DATA_MIGRATION",
          "AUTH_SECURITY",
          "FIREBASE",
          "PRIVACY"
        ],
        "operations": [
          "CONFIG",
          "TEST_ONLY",
          "BUG_FIX",
          "FEATURE",
          "REFACTOR",
          "ARCHITECTURAL",
          "CRITICAL_RUNTIME"
        ]
      },
      "repositories": [
        "wayper",
        "wayper-site"
      ],
      "checks": [
        "mobile-L1",
        "mobile-L2",
        "site-L1",
        "site-L2"
      ]
    },
    {
      "id": "lifecycle",
      "when": {
        "risks": [
          "LIFECYCLE"
        ],
        "operations": [
          "CONFIG",
          "BUG_FIX",
          "FEATURE",
          "REFACTOR",
          "ARCHITECTURAL",
          "CRITICAL_RUNTIME"
        ]
      },
      "repositories": [
        "wayper",
        "wayper-site"
      ],
      "checks": [
        "mobile-L1",
        "mobile-L2",
        "mobile-runtime",
        "android-build",
        "ios-build",
        "site-L1",
        "site-L2",
        "site-runtime"
      ]
    },
    {
      "id": "permissions-notification",
      "when": {
        "capabilities": [
          "onboarding-permissions",
          "active-run-notification"
        ],
        "operations": [
          "CONFIG",
          "BUG_FIX",
          "FEATURE",
          "REFACTOR",
          "ARCHITECTURAL",
          "CRITICAL_RUNTIME"
        ]
      },
      "repositories": [
        "wayper"
      ],
      "checks": [
        "mobile-L1",
        "mobile-runtime",
        "android-build",
        "ios-build"
      ]
    },
    {
      "id": "native-risk",
      "when": {
        "risks": [
          "NATIVE_ANDROID"
        ],
        "operations": [
          "CONFIG",
          "BUG_FIX",
          "FEATURE",
          "REFACTOR",
          "ARCHITECTURAL",
          "CRITICAL_RUNTIME"
        ]
      },
      "repositories": [
        "wayper"
      ],
      "checks": [
        "android-build"
      ]
    },
    {
      "id": "native-capability",
      "when": {
        "capabilities": [
          "android-run-boundary"
        ],
        "operations": [
          "CONFIG",
          "BUG_FIX",
          "FEATURE",
          "REFACTOR",
          "ARCHITECTURAL",
          "CRITICAL_RUNTIME"
        ]
      },
      "repositories": [
        "wayper"
      ],
      "checks": [
        "android-build"
      ]
    },
    {
      "id": "native-path",
      "when": {
        "pathPatterns": [
          "^android/.*\\.(?:kt|java|gradle|kts)$",
          "^android/.*AndroidManifest\\.xml$"
        ],
        "operations": [
          "CONFIG",
          "TEST_ONLY",
          "BUG_FIX",
          "FEATURE",
          "REFACTOR",
          "ARCHITECTURAL",
          "CRITICAL_RUNTIME"
        ]
      },
      "repositories": [
        "wayper"
      ],
      "checks": [
        "android-build"
      ]
    },
    {
      "id": "gps-pipeline",
      "when": {
        "capabilities": [
          "live-gps-ingestion"
        ],
        "operations": [
          "CONFIG",
          "TEST_ONLY",
          "BUG_FIX",
          "FEATURE",
          "REFACTOR",
          "ARCHITECTURAL",
          "CRITICAL_RUNTIME"
        ]
      },
      "repositories": [
        "wayper"
      ],
      "checks": [
        "mobile-L1",
        "mobile-L2"
      ]
    },
    {
      "id": "rendering",
      "when": {
        "claims": [
          "RENDERING",
          "ASSISTIVE",
          "RUNTIME",
          "PROCESS_DEATH"
        ]
      },
      "repositories": [
        "wayper",
        "wayper-site"
      ],
      "checks": [
        "mobile-runtime",
        "site-runtime"
      ]
    },
    {
      "id": "remote-service",
      "when": {
        "claims": [
          "REMOTE_SERVICE"
        ]
      },
      "repositories": [
        "wayper",
        "wayper-site"
      ],
      "checks": [
        "mobile-L1",
        "mobile-L2",
        "mobile-remote",
        "site-L1",
        "site-L2",
        "site-remote"
      ]
    },
    {
      "id": "physical-claim",
      "when": {
        "claims": [
          "PHYSICAL_DEVICE",
          "REAL_SCENARIO",
          "PROCESS_DEATH"
        ]
      },
      "repositories": [
        "wayper",
        "wayper-site"
      ],
      "checks": [
        "mobile-L5",
        "site-L5"
      ]
    },
    {
      "id": "real-scenario",
      "when": {
        "claims": [
          "REAL_SCENARIO"
        ]
      },
      "repositories": [
        "wayper",
        "wayper-site"
      ],
      "checks": [
        "mobile-L6",
        "site-L6"
      ]
    },
    {
      "id": "webgl",
      "when": {
        "claims": [
          "WEBGL"
        ]
      },
      "repositories": [
        "wayper-site"
      ],
      "checks": [
        "webgl-unit",
        "webgl-browser"
      ]
    },
    {
      "id": "architectural-class",
      "when": {
        "taskClasses": [
          "ARCHITECTURAL",
          "CRITICAL_RUNTIME"
        ],
        "operations": [
          "CONFIG",
          "TEST_ONLY",
          "BUG_FIX",
          "FEATURE",
          "REFACTOR",
          "ARCHITECTURAL",
          "CRITICAL_RUNTIME"
        ]
      },
      "repositories": [
        "wayper",
        "wayper-site"
      ],
      "checks": [
        "mobile-L2",
        "site-L2"
      ]
    },
    {
      "id": "lifecycle-capability",
      "when": {
        "capabilities": [
          "active-run-lifecycle"
        ],
        "operations": [
          "CONFIG",
          "BUG_FIX",
          "FEATURE",
          "REFACTOR",
          "ARCHITECTURAL",
          "CRITICAL_RUNTIME"
        ]
      },
      "repositories": [
        "wayper"
      ],
      "checks": [
        "mobile-runtime",
        "android-build",
        "ios-build"
      ]
    }
  ]
}
