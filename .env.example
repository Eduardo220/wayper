# Modelo de ambiente do Wayper
# Use este arquivo como base do .env local e preencha os valores do seu projeto Firebase.

# App
EXPO_PUBLIC_APP_ENV=development

# Firebase client config
# Estes valores sao identificadores publicos do cliente, mas o .env real fica fora do git.
EXPO_PUBLIC_FIREBASE_API_KEY=replace_with_firebase_api_key
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=replace_with_project.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=replace_with_project_id
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=replace_with_project.appspot.com
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=replace_with_sender_id
EXPO_PUBLIC_FIREBASE_APP_ID=replace_with_firebase_app_id
EXPO_PUBLIC_FIREBASE_MEASUREMENT_ID=replace_with_measurement_id

# Google sign-in
# Preencha apenas os clients usados pelos seus alvos de build.
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_EXPO_CLIENT_ID=

# Scripts locais Android
# Opcional: force um device especifico do adb devices.
WAYPER_ANDROID_DEVICE=
ANDROID_SERIAL=

# Opcional: localizacao fixa do emulador para npm run dev:location.
WAYPER_EMULATOR_LAT=
WAYPER_EMULATOR_LNG=
