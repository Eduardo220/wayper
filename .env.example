# Runtime monitoring. The DSN is public by design, but keep environments separated.
EXPO_PUBLIC_APP_ENV=development
EXPO_PUBLIC_SENTRY_DSN=
EXPO_PUBLIC_SENTRY_ENABLED=true
EXPO_PUBLIC_SENTRY_ENABLE_DEV=false
EXPO_PUBLIC_SENTRY_TEST_ENABLED=false

# Build-time source map upload. Store the token as an EAS/CI secret.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=wayper
SENTRY_PROJECT=react-native

# Existing optional diagnostics upload.
EXPO_PUBLIC_WAYPER_DIAGNOSTICS_UPLOAD_ENABLED=false
