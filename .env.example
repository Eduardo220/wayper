# Public runtime config. Copy to .env.development.local or .env.production.local
# when a local machine needs values that must not be committed.
EXPO_PUBLIC_SENTRY_DSN=
EXPO_PUBLIC_SENTRY_ENABLED=
EXPO_PUBLIC_SENTRY_ENABLE_DEV=
EXPO_PUBLIC_SENTRY_TEST_ENABLED=
EXPO_PUBLIC_SENTRY_DEBUG=
EXPO_PUBLIC_APP_ENV=
EXPO_PUBLIC_BUILD_PROFILE=
EXPO_PUBLIC_APP_VARIANT=
EXPO_PUBLIC_APPLICATION_ID=
EXPO_PUBLIC_EAS_UPDATE_CHANNEL=

# Build-time Sentry upload config. Keep real values in EAS/CI secrets or local
# .env.*.local files; never commit tokens or credentials.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# Existing optional diagnostics upload.
EXPO_PUBLIC_WAYPER_DIAGNOSTICS_UPLOAD_ENABLED=false
