# Expo prebuild output is generated. Wayper keeps the custom Android
# notification/run module below as source, so those files are unignored.
/android/
!/android/
/android/*
!/android/app/
/android/app/*
!/android/app/src/
/android/app/src/*
!/android/app/src/main/
/android/app/src/main/*
!/android/app/src/main/AndroidManifest.xml
!/android/app/src/main/java/
/android/app/src/main/java/*
!/android/app/src/main/java/com/
/android/app/src/main/java/com/*
!/android/app/src/main/java/com/wayper/
/android/app/src/main/java/com/wayper/*
!/android/app/src/main/java/com/wayper/app/
/android/app/src/main/java/com/wayper/app/*
!/android/app/src/main/java/com/wayper/app/MainActivity.kt
!/android/app/src/main/java/com/wayper/app/MainApplication.kt
!/android/app/src/main/java/com/wayper/app/run/
!/android/app/src/main/java/com/wayper/app/run/**

