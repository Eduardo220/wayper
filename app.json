{
  "expo": {
    "scheme": "wayper",
    "name": "wayper",
    "slug": "wayper",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,

    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },

    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.wayper.app",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "O Wayper utiliza sua localização para registrar corridas e áreas conquistadas.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "Sua localização em tempo real é essencial para registrar seu trajeto.",
        "NSLocationAlwaysUsageDescription": "O Wayper precisa da sua localização para registrar seu percurso durante as corridas.",
        "UIBackgroundModes": ["location", "fetch"]
      }
    },

    "android": {
      "package": "com.wayper.app",
      "googleServicesFile": "./google-services.json",

      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION",
        "WAKE_LOCK",
        "INTERNET",
        "VIBRATE"
      ],

      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },

      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyDMEuHH1fq9qlGL6cfIK6jA9UvqD4YFS6Y"
        }
      },

      "softwareKeyboardLayoutMode": "pan",
      "blockedPermissions": []
    },

    "plugins": [
      "expo-web-browser",
      "expo-barcode-scanner",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "O Wayper precisa da sua localização mesmo em segundo plano para registrar corridas corretamente.",
          "isAndroidBackgroundLocationEnabled": true
        }
      ],
      "expo-task-manager"
    ],

    "extra": {
      "eas": {
        "projectId": "9fcacdf5-6972-47d9-81b9-19810cb93c3f"
      }
    }
  }
}
