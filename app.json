{
  "expo": {
    "scheme": "wayper",
    "name": "Wayper",
    "slug": "wayper",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/logo.png",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,

    "splash": {
      "image": "./assets/logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#03070B"
    },

    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.wayper.app",
      "buildNumber": "1",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "O Wayper utiliza sua localização para registrar corridas e áreas conquistadas.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "Sua localização em tempo real é essencial para registrar seu trajeto.",
        "NSLocationAlwaysUsageDescription": "O Wayper precisa da sua localização para registrar seu percurso durante as corridas.",
        "NSPhotoLibraryUsageDescription": "O Wayper precisa acessar a galeria para salvar imagens das suas corridas.",
        "NSPhotoLibraryAddUsageDescription": "O Wayper precisa salvar imagens das suas corridas na galeria.",
        "UIFileSharingEnabled": true,
        "LSSupportsOpeningDocumentsInPlace": true,
        "UIBackgroundModes": ["location", "fetch"]
      }
    },

    "android": {
      "package": "com.wayper.app",
      "versionCode": 1,
      "googleServicesFile": "./google-services.json",

      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_LOCATION",
        "POST_NOTIFICATIONS",
        "READ_MEDIA_IMAGES",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "WAKE_LOCK",
        "INTERNET"
      ],

      "adaptiveIcon": {
        "foregroundImage": "./assets/logo.png",
        "backgroundColor": "#03070B"
      },

      "softwareKeyboardLayoutMode": "pan",
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.VIBRATE"
      ]
    },

    "plugins": [
      [
        "./plugins/withAsyncStorageDatabaseSize.cjs",
        {
          "sizeMB": 32
        }
      ],
      "@maplibre/maplibre-react-native",
      "expo-web-browser",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "O Wayper precisa da sua localização mesmo em segundo plano para registrar corridas corretamente.",
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "O Wayper precisa acessar a galeria para salvar imagens das suas corridas.",
          "savePhotosPermission": "O Wayper precisa salvar imagens das suas corridas na galeria.",
          "isAccessMediaLocationEnabled": false,
          "granularPermissions": ["photo"]
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "O Wayper precisa acessar suas fotos somente quando voce escolher uma imagem."
        }
      ],
      "expo-file-system",
      "expo-task-manager",
      [
        "@sentry/react-native/expo",
        {
          "organization": "wayper",
          "project": "react-native"
        }
      ],
      "expo-font",
      "expo-background-task"
    ],

    "extra": {
      "eas": {
        "projectId": "9fcacdf5-6972-47d9-81b9-19810cb93c3f"
      }
    }
  }
}
