{
  "type": "module",
  "name": "wayper",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "start": "expo start --dev-client",
    "start:clean": "expo start --dev-client -c",
    "dev": "npm run dev:emulator",
    "dev:clean": "npm run dev:emulator:clean",
    "dev:server": "expo start --dev-client --host localhost",
    "dev:server:clean": "expo start --dev-client --host localhost -c",
    "dev:lan": "expo start --dev-client --host lan",
    "dev:lan:clean": "expo start --dev-client --host lan -c",
    "dev:location": "node scripts/set-emulator-location.cjs",
    "dev:location:optional": "node scripts/set-emulator-location.cjs --optional",
    "dev:tunnel": "expo start --dev-client --tunnel",
    "dev:tunnel:clean": "expo start --dev-client --tunnel -c",
    "dev:android": "npm run dev:android:emulator",
    "dev:android:emulator": "node scripts/run-expo-android-device.cjs --target emulator --variant debug",
    "dev:android:emulator:no-bundler": "node scripts/run-expo-android-device.cjs --target emulator --variant debug --no-bundler",
    "dev:android:device": "node scripts/run-expo-android-device.cjs --target physical --variant debug",
    "dev:android:device:no-bundler": "node scripts/run-expo-android-device.cjs --target physical --variant debug --no-bundler",
    "dev:emulator": "concurrently --kill-others-on-fail -n METRO,LOCATION,ANDROID -c green,yellow,cyan \"npm:dev:server\" \"npm:dev:location:optional\" \"wait-on tcp:127.0.0.1:8081 && npm run dev:android:emulator:no-bundler\"",
    "dev:emulator:clean": "concurrently --kill-others-on-fail -n METRO,LOCATION,ANDROID -c green,yellow,cyan \"npm:dev:server:clean\" \"npm:dev:location:optional\" \"wait-on tcp:127.0.0.1:8081 && npm run dev:android:emulator:no-bundler\"",
    "dev:phone": "concurrently --kill-others-on-fail -n LAN,ANDROID -c green,cyan \"npm:dev:lan\" \"wait-on tcp:127.0.0.1:8081 && npm run dev:android:device:no-bundler\"",
    "dev:phone:clean": "concurrently --kill-others-on-fail -n LAN,ANDROID -c green,cyan \"npm:dev:lan:clean\" \"wait-on tcp:127.0.0.1:8081 && npm run dev:android:device:no-bundler\"",
    "dev:phone:tunnel": "concurrently --kill-others-on-fail -n TUNNEL,ANDROID -c green,cyan \"npm:dev:tunnel\" \"wait-on tcp:127.0.0.1:8081 && npm run dev:android:device:no-bundler\"",
    "dev:phone:tunnel:clean": "concurrently --kill-others-on-fail -n TUNNEL,ANDROID -c green,cyan \"npm:dev:tunnel:clean\" \"wait-on tcp:127.0.0.1:8081 && npm run dev:android:device:no-bundler\"",
    "rua": "npm run dev:phone:tunnel",
    "rua:clean": "npm run dev:phone:tunnel:clean",
    "rua:start": "npm run dev:tunnel",
    "rua:install": "npm run dev:android:device:no-bundler",
    "rua:apk": "npm run dev:apk",
    "teste:emulador": "npm run dev:emulator",
    "teste:celular": "npm run dev:phone",
    "teste:rua": "npm run rua",
    "test:emulator": "npm run teste:emulador",
    "test:device": "npm run teste:celular",
    "dev:apk": "npm run android:build:debug && npm run apk:copy:debug",
    "prod": "npm run prod:device",
    "prod:device": "npm run prod:apk && npm run prod:install",
    "prod:install": "node scripts/install-android-apk.cjs dist/Wayper-standalone-release.apk --target physical --package com.wayper.app",
    "prod:android": "expo run:android --variant release",
    "prod:android:device": "npm run prod:device",
    "prod:apk": "npm run android:build:release && npm run apk:copy:release",
    "prod:aab": "npm run android:build:aab",
    "android": "npm run dev:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "android:prebuild": "expo prebuild --platform android --clean",
    "android:run": "npm run dev:android",
    "android:clean": "node scripts/run-gradle.cjs clean",
    "android:build:debug": "node scripts/run-gradle.cjs assembleDebug",
    "android:build:release": "node scripts/run-gradle.cjs assembleRelease -PreactNativeArchitectures=armeabi-v7a,arm64-v8a",
    "android:build:aab": "node scripts/run-gradle.cjs bundleRelease",
    "android:build:all": "npm run android:build:debug && npm run android:build:release",
    "apk:copy:debug": "node scripts/copy-android-apk.cjs debug",
    "apk:copy:release": "node scripts/copy-android-apk.cjs release",
    "apk:copy": "node scripts/copy-android-apk.cjs all",
    "apk:dev": "npm run dev:apk",
    "apk:prod": "npm run prod:apk",
    "apk:all": "npm run android:build:all && npm run apk:copy",
    "eas:dev": "npx eas-cli build -p android --profile development",
    "eas:preview": "npx eas-cli build -p android --profile preview",
    "eas:prod": "npx eas-cli build -p android --profile production",
    "clean": "rd /s /q node_modules && del package-lock.json && npm install && npm dedupe"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@maplibre/maplibre-react-native": "^11.2.1",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-native-community/netinfo": "11.4.1",
    "@react-navigation/drawer": "^7.7.1",
    "@react-navigation/native": "^7.1.19",
    "@react-navigation/native-stack": "^7.6.0",
    "@shopify/react-native-skia": "^2.4.5",
    "@tanstack/query-async-storage-persister": "^5.90.14",
    "@tanstack/react-query": "^5.90.12",
    "@tanstack/react-query-persist-client": "^5.90.14",
    "@turf/turf": "^7.3.0",
    "expo": "~54.0.25",
    "expo-auth-session": "~7.0.9",
    "expo-background-fetch": "~14.0.8",
    "expo-background-task": "~1.0.9",
    "expo-constants": "~18.0.10",
    "expo-crypto": "~15.0.7",
    "expo-dev-client": "~6.0.21",
    "expo-file-system": "~19.0.19",
    "expo-image-picker": "~17.0.8",
    "expo-linear-gradient": "~15.0.7",
    "expo-location": "~19.0.7",
    "expo-sharing": "~14.0.7",
    "expo-status-bar": "~3.0.8",
    "expo-task-manager": "~14.0.8",
    "expo-web-browser": "~15.0.9",
    "firebase": "^12.6.0",
    "firebase-admin": "^13.6.0",
    "kalmanjs": "^1.1.0",
    "moti": "^0.30.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-qrcode-svg": "^6.3.16",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "^15.15.1",
    "react-native-view-shot": "^4.0.3"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "wait-on": "^8.0.3"
  },
  "private": true,
  "resolutions": {
    "react": "19.1.0",
    "react-dom": "19.1.0"
  }
}
