{
  "type": "module",
  "name": "wayper",
  "version": "1.0.0",
  "main": "index.js",

  "scripts": {
    "start": "expo start",
    "start:clean": "expo start -c",

    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",

    "android:prebuild": "npx expo prebuild --platform android --clean",
    "android:run": "npx expo run:android",
    "android:clean": "cd android && ./gradlew clean || gradlew clean && cd ..",

    "android:build:debug": "cd android && ./gradlew assembleDebug && cd ..",
    "android:build:release": "cd android && ./gradlew assembleRelease && cd ..",

    "clean": "rd /s /q node_modules && del package-lock.json && npm install && npm dedupe"
  },

  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-native-community/netinfo": "11.4.1",

